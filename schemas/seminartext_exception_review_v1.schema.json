{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yurielo/integra/schemas/seminartext_exception_review_v1.schema.json",
  "title": "Integra SeminarText unresolved review artifact v1",
  "type": "object",
  "required": ["input_artifact_ids", "input_content_sha256", "result", "schema_version", "semantic_status", "stage", "stage_data"],
  "properties": {
    "input_artifact_ids": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
    "input_content_sha256": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "result": {
      "type": "object",
      "required": ["unreviewed", "human_decision_required", "technical_status"],
      "properties": {
        "unreviewed": {"type": "integer", "minimum": 1},
        "human_decision_required": {"const": true},
        "technical_status": {"const": "REVIEW_REQUIRED"}
      },
      "additionalProperties": false
    },
    "schema_version": {"const": "1.0"},
    "semantic_status": {"const": "REVIEW_REQUIRED"},
    "stage": {"const": "review"},
    "stage_data": {
      "type": "object",
      "required": ["alignment_result", "canonical_bundle", "draft_input_document", "review_package"],
      "properties": {
        "alignment_result": {"$ref": "#/$defs/alignment_result"},
        "canonical_bundle": {"$ref": "#/$defs/canonical_bundle"},
        "draft_input_document": {"type": "object", "minProperties": 1},
        "review_package": {"$ref": "#/$defs/review_package"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "alignment_result": {
      "type": "object",
      "required": ["alignment_run_id", "bundle", "status", "unaligned_words"],
      "properties": {
        "alignment_run_id": {"type": "string", "minLength": 1},
        "bundle": {"const": "evidence/canonical_bundle.json"},
        "status": {"const": "review_required"},
        "unaligned_words": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": false
    },
    "canonical_bundle": {
      "type": "object",
      "required": ["alignment_runs", "artifact_id", "artifact_type", "benchmark_segments", "cues", "evidence_refs", "project", "schema_version", "sources", "topics", "transcript_revisions", "words"],
      "properties": {
        "alignment_runs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_type": {"const": "seminartext.canonical_evidence"},
        "benchmark_segments": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "cues": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "evidence_refs": {"type": "array"},
        "project": {"type": "object", "required": ["id", "lifecycle_status", "title"], "properties": {"id": {"type": "string", "minLength": 1}, "lifecycle_status": {"const": "active"}, "title": {"type": "string", "minLength": 1}}, "additionalProperties": false},
        "schema_version": {"const": "1.0.0"},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "topics": {"type": "array"},
        "transcript_revisions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "words": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/canonical_word"}}
      },
      "additionalProperties": false
    },
    "canonical_word": {
      "type": "object",
      "required": ["alignment_status", "char_end", "char_start", "confidence", "end_seconds", "id", "lifecycle_status", "normalized_text", "qa_flags", "sequence", "source_cue_ids", "source_id", "speaker_id", "start_seconds", "text", "timing_provenance", "transcript_revision_id"],
      "properties": {
        "alignment_status": {"enum": ["aligned", "unaligned"]},
        "char_end": {"type": "integer", "minimum": 0},
        "char_start": {"type": "integer", "minimum": 0},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "end_seconds": {"type": ["number", "null"], "minimum": 0},
        "id": {"type": "string", "minLength": 1},
        "lifecycle_status": {"const": "active"},
        "normalized_text": {"type": ["string", "null"]},
        "qa_flags": {"type": "array"},
        "sequence": {"type": "integer", "minimum": 0},
        "source_cue_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_id": {"type": "string", "minLength": 1},
        "speaker_id": {"type": ["string", "null"]},
        "start_seconds": {"type": ["number", "null"], "minimum": 0},
        "text": {"type": "string", "minLength": 1},
        "timing_provenance": {"type": "object", "required": ["alignment_run_id", "kind", "method"], "properties": {"alignment_run_id": {"type": ["string", "null"]}, "kind": {"enum": ["forced_alignment", "unavailable"]}, "method": {"type": ["string", "null"]}}, "additionalProperties": false},
        "transcript_revision_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "review_package": {
      "type": "object",
      "required": ["artifact_id", "artifact_type", "canonical_evidence", "draft_input", "evidence", "project", "review_policy", "schema_version", "seminar", "topics"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "artifact_type": {"const": "seminartext.topic_review_package"},
        "canonical_evidence": {"type": "object"},
        "draft_input": {"type": "object"},
        "evidence": {"type": "array"},
        "project": {"type": "object"},
        "review_policy": {"type": "object"},
        "schema_version": {"const": "1.0.0"},
        "seminar": {"type": "object"},
        "topics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/review_topic"}}
      },
      "additionalProperties": false
    },
    "review_topic": {
      "type": "object",
      "required": ["evidence_refs", "evidence_sha256", "generator", "id", "lifecycle_status", "locator", "proposed_summary", "proposed_title", "quote", "review_history", "semantic_origin", "seminar_id", "sequence", "source_id", "topic_set_id", "topic_sha256", "transcript_provenance", "transcript_revision_id", "word_end_id", "word_end_sequence", "word_start_id", "word_start_sequence"],
      "properties": {
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generator": {"type": "object"},
        "id": {"type": "string", "minLength": 1},
        "lifecycle_status": {"const": "REVIEW_REQUIRED"},
        "locator": {"type": "object", "required": ["type", "start_seconds", "end_seconds"], "properties": {"type": {"const": "time_interval"}, "start_seconds": {"type": "number", "minimum": 0}, "end_seconds": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
        "proposed_summary": {"type": "string", "minLength": 1},
        "proposed_title": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1},
        "review_history": {"const": []},
        "semantic_origin": {"const": "machine_assisted"},
        "seminar_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 0},
        "source_id": {"type": "string", "minLength": 1},
        "topic_set_id": {"type": "string", "minLength": 1},
        "topic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "transcript_provenance": {"type": "object"},
        "transcript_revision_id": {"type": "string", "minLength": 1},
        "word_end_id": {"type": "string", "minLength": 1},
        "word_end_sequence": {"type": "integer", "minimum": 0},
        "word_start_id": {"type": "string", "minLength": 1},
        "word_start_sequence": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
