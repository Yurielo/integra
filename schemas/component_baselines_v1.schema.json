{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yurielo/integra/schemas/component_baselines_v1.schema.json",
  "title": "Integra pinned source component baselines v1",
  "type": "object",
  "required": [
    "schema_version",
    "verified_at",
    "integration_policy",
    "components",
    "r1_acceptance"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "verified_at": { "type": "string", "format": "date-time" },
    "integration_policy": {
      "type": "object",
      "required": ["source_repositories", "dependency_mode", "unmerged_work_allowed"],
      "properties": {
        "source_repositories": { "const": "READ_ONLY" },
        "dependency_mode": { "const": "PINNED_COMMIT_AND_VERSIONED_CONTRACT" },
        "unmerged_work_allowed": { "const": false }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "repository",
          "default_branch",
          "commit_sha",
          "tree_sha",
          "source_tree_clean",
          "version",
          "supported_contracts",
          "verification",
          "known_limitations"
        ],
        "properties": {
          "id": { "enum": ["seminartext", "videotext"] },
          "repository": { "type": "string", "minLength": 1 },
          "default_branch": { "const": "main" },
          "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "tree_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "source_tree_clean": { "const": true },
          "version": { "type": "string", "minLength": 1 },
          "build": { "type": "string", "minLength": 1 },
          "project_schema_version": { "type": "integer", "minimum": 1 },
          "supported_contracts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "path", "sha256"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              },
              "additionalProperties": false
            }
          },
          "verification": {
            "type": "object",
            "required": ["deterministic_suite", "ci", "real_media"],
            "properties": {
              "deterministic_suite": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
              "ci": { "enum": ["PASS", "FAIL", "NOT_CONFIGURED"] },
              "real_media": { "enum": ["PASS", "INCOMPLETE", "NOT_APPLICABLE"] }
            },
            "additionalProperties": true
          },
          "known_limitations": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "r1_acceptance": {
      "type": "object",
      "required": [
        "manifest_reproducible",
        "unmerged_work_is_dependency",
        "source_applications_release_certified",
        "status"
      ],
      "properties": {
        "manifest_reproducible": { "const": true },
        "unmerged_work_is_dependency": { "const": false },
        "source_applications_release_certified": { "type": "boolean" },
        "status": { "enum": ["PASS", "PARTIAL", "FAIL"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
