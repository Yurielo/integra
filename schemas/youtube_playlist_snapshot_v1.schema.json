{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.local/schemas/youtube_playlist_snapshot_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "playlist_native_id", "fetched_at", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "provider": {"const": "youtube"},
    "playlist_native_id": {"type": "string", "minLength": 1},
    "fetched_at": {"type": "string", "pattern": "Z$"},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["video_id", "position", "title", "availability", "duration_seconds", "estimated_download_bytes"],
        "properties": {
          "video_id": {"type": "string", "minLength": 1},
          "position": {"type": "integer", "minimum": 0},
          "title": {"type": "string", "minLength": 1},
          "availability": {"enum": ["AVAILABLE", "INACCESSIBLE"]},
          "duration_seconds": {"type": "integer", "minimum": 0},
          "estimated_download_bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
