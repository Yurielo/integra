{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yurielo/integra/schemas/seminartext_knowledge_candidate_v1.schema.json",
  "title": "Integra SeminarText provisional knowledge candidate artifact v1",
  "type": "object",
  "required": ["input_artifact_ids", "input_content_sha256", "result", "schema_version", "semantic_status", "stage", "stage_data"],
  "properties": {
    "input_artifact_ids": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "input_content_sha256": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/sha256"}},
    "result": {
      "type": "object",
      "required": ["lifecycle", "manifest_sha256"],
      "properties": {
        "lifecycle": {"const": "PROVISIONAL"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "schema_version": {"const": "1.0"},
    "semantic_status": {"const": "PROVISIONAL"},
    "stage": {"const": "knowledge"},
    "stage_data": {
      "type": "object",
      "required": ["export_files", "export_manifest", "export_manifest_text"],
      "properties": {
        "export_files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "export_manifest": {"$ref": "#/$defs/export_manifest"},
        "export_manifest_text": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "export_manifest": {
      "type": "object",
      "required": ["artifact_type", "canonical_evidence_artifact_id", "canonical_evidence_sha256", "canonical_knowledge_artifact_id", "canonical_knowledge_sha256", "coverage", "files", "kind", "ownership_classes", "resolver_states", "schema_version"],
      "properties": {
        "artifact_type": {"const": "seminartext.managed_generated_export"},
        "canonical_evidence_artifact_id": {"type": "string", "minLength": 1},
        "canonical_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_knowledge_artifact_id": {"type": "string", "minLength": 1},
        "canonical_knowledge_sha256": {"$ref": "#/$defs/sha256"},
        "coverage": {
          "type": "object",
          "required": ["artifact_type", "full_seminar_coverage", "project_id", "schema_version", "sources"],
          "properties": {
            "artifact_type": {"const": "seminartext.project_knowledge_coverage"},
            "full_seminar_coverage": {"const": true},
            "project_id": {"type": "string", "minLength": 1},
            "schema_version": {"const": 1},
            "sources": {"type": "array", "minItems": 1, "items": {"type": "object"}}
          },
          "additionalProperties": false
        },
        "files": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "kind": {"const": "obsidian_derived_view"},
        "ownership_classes": {"const": ["MANAGED_GENERATED", "USER_OWNED"]},
        "resolver_states": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "schema_version": {"const": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
