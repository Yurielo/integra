{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yurielo/integra/schemas/videotext_stage_a_result_v1.schema.json",
  "title": "Isolated VideoText Stage A transcript evidence",
  "type": "object",
  "required": ["schema_version", "state", "cache_state", "review_checkpoint", "semantic_authority", "runtime", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "state": {"enum": ["REVIEW_REQUIRED", "REUSED"]},
    "cache_state": {"enum": ["COLD", "WARM"]},
    "review_checkpoint": {"const": "SOURCE_TRANSCRIPT"},
    "semantic_authority": {"const": "MACHINE_UNVERIFIED"},
    "runtime": {"type": "object", "required": ["component", "commit_sha", "worker_sha256", "seminartext_dependency"]},
    "artifacts": {"type": "object", "required": ["srt", "transcript", "whisper_json", "manifest", "quality", "review_tasks"]}
  },
  "additionalProperties": true
}
