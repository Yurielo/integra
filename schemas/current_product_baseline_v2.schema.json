{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Integra Current Product Baseline v2",
  "type": "object",
  "required": ["schema_version", "artifact_type", "current_id", "records"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_type": {"const": "integra.current_product_baseline"},
    "current_id": {"type": "string", "minLength": 1},
    "records": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["baseline_id", "status", "repository", "main", "candidate", "acceptance", "promotion", "promotion_policy", "historical_predecessors", "governed_files"]}}
  },
  "additionalProperties": false
}
