{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yurielo/integra/schemas/project_source_registry_v1.schema.json",
  "title": "Integra Project and Source Registry v1",
  "type": "object",
  "required": ["schema_version", "registry_id", "registry_key", "created_at", "updated_at", "revision", "projects", "sources", "record_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry_id": {"$ref": "#/$defs/urn"},
    "registry_key": {"type": "string", "minLength": 1},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "revision": {"type": "integer", "minimum": 0},
    "projects": {
      "type": "array",
      "items": {"$ref": "#/$defs/project"}
    },
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "urn": {"type": "string", "pattern": "^urn:integra:[a-z][a-z0-9_]{1,31}:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "project": {
      "type": "object",
      "required": ["project_id", "project_key", "identity_sha256", "kind", "title", "lifecycle", "created_at", "updated_at", "revision", "source_ids", "history"],
      "properties": {
        "project_id": {"$ref": "#/$defs/urn"},
        "project_key": {"type": "string", "minLength": 1},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "kind": {"enum": ["SEMINAR", "COURSE", "SERIES", "EVENT"]},
        "title": {"type": "string", "minLength": 1},
        "lifecycle": {"enum": ["ACTIVE", "ARCHIVED"]},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "updated_at": {"$ref": "#/$defs/timestamp"},
        "revision": {"type": "integer", "minimum": 1},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/urn"}},
        "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["event_id", "ordinal", "event_type", "occurred_at", "details"],
      "properties": {
        "event_id": {"$ref": "#/$defs/urn"},
        "ordinal": {"type": "integer", "minimum": 1},
        "event_type": {"enum": ["CREATED", "RENAMED", "LIFECYCLE_CHANGED", "SOURCE_ATTACHED"]},
        "occurred_at": {"$ref": "#/$defs/timestamp"},
        "details": {"type": "object"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["source_id", "identity_sha256", "source_type", "display_name", "lifecycle", "origin", "project_ids", "current_revision_id", "revisions", "memberships", "collection_membership_ids"],
      "properties": {
        "source_id": {"$ref": "#/$defs/urn"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "source_type": {"enum": ["LOCAL_VIDEO", "LOCAL_AUDIO", "YOUTUBE_VIDEO", "YOUTUBE_PLAYLIST", "PDF", "PPTX", "DOCX", "TXT", "MARKDOWN", "IMAGE", "SCAN"]},
        "display_name": {"type": "string", "minLength": 1},
        "lifecycle": {"enum": ["ACTIVE", "UNAVAILABLE", "ARCHIVED"]},
        "origin": {
          "type": "object",
          "required": ["kind", "component", "native_id"],
          "properties": {
            "kind": {"enum": ["LOCAL", "REMOTE", "PIPELINE"]},
            "component": {"type": "string", "minLength": 1},
            "native_id": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "project_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/urn"}},
        "current_revision_id": {"$ref": "#/$defs/urn"},
        "revisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/revision"}},
        "memberships": {"type": "array", "items": {"$ref": "#/$defs/membership"}},
        "collection_membership_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/urn"}}
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "object",
      "required": ["revision_id", "ordinal", "previous_revision_id", "captured_at", "revision_sha256", "availability", "provenance_sha256", "provenance"],
      "properties": {
        "revision_id": {"$ref": "#/$defs/urn"},
        "ordinal": {"type": "integer", "minimum": 1},
        "previous_revision_id": {"anyOf": [{"$ref": "#/$defs/urn"}, {"type": "null"}]},
        "captured_at": {"$ref": "#/$defs/timestamp"},
        "revision_sha256": {"$ref": "#/$defs/sha256"},
        "availability": {"enum": ["AVAILABLE", "INACCESSIBLE"]},
        "provenance_sha256": {"$ref": "#/$defs/sha256"},
        "provenance": {"type": "object", "minProperties": 3}
      },
      "additionalProperties": false
    },
    "membership": {
      "type": "object",
      "required": ["membership_id", "video_source_id", "collection_id", "playlist_native_id", "snapshot_id", "snapshot_sha256", "observed_at", "position", "item_title", "availability", "duration_seconds", "estimated_download_bytes", "relationship_sha256"],
      "properties": {
        "membership_id": {"$ref": "#/$defs/urn"},
        "video_source_id": {"$ref": "#/$defs/urn"},
        "collection_id": {"$ref": "#/$defs/urn"},
        "playlist_native_id": {"type": "string", "minLength": 1},
        "snapshot_id": {"$ref": "#/$defs/urn"},
        "snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "position": {"type": "integer", "minimum": 0},
        "item_title": {"type": "string", "minLength": 1},
        "availability": {"enum": ["AVAILABLE", "INACCESSIBLE"]},
        "duration_seconds": {"type": "integer", "minimum": 0},
        "estimated_download_bytes": {"type": "integer", "minimum": 0},
        "relationship_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
