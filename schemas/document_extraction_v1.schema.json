{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.local/schemas/document_extraction_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document_id", "source", "captured_at",
    "page_or_slide_count", "content_mode", "native_extraction", "ocr",
    "embedded_media", "fidelity", "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document_id": {"type": "string", "pattern": "^urn:integra:artifact:"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "revision_id", "display_name", "format", "media_type", "sha256", "size_bytes"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^urn:integra:source:"},
        "revision_id": {"type": "string", "pattern": "^urn:integra:revision:"},
        "display_name": {"type": "string", "minLength": 1},
        "format": {"enum": ["PDF", "PPTX", "DOCX", "TXT", "MARKDOWN", "IMAGE"]},
        "media_type": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "captured_at": {"type": "string", "pattern": "Z$"},
    "page_or_slide_count": {"type": ["integer", "null"], "minimum": 1},
    "content_mode": {"enum": ["TEXT", "MIXED", "IMAGE_HEAVY", "SCAN"]},
    "native_extraction": {"$ref": "#/$defs/nativeExtraction"},
    "ocr": {"$ref": "#/$defs/ocrExtraction"},
    "embedded_media": {
      "type": "array",
      "items": {"$ref": "#/$defs/embeddedMedia"}
    },
    "fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_hash_verified", "exact_locators", "embedded_media_hashes_verified", "image_heavy_not_plain_text", "semantic_authority"],
      "properties": {
        "source_hash_verified": {"const": true},
        "exact_locators": {"const": true},
        "embedded_media_hashes_verified": {"const": true},
        "image_heavy_not_plain_text": {"const": true},
        "semantic_authority": {"const": "PROVISIONAL_MACHINE_EXTRACTION"}
      }
    },
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_kind", "unit_index", "region", "character_start", "character_end"],
      "properties": {
        "unit_kind": {"enum": ["DOCUMENT", "PARAGRAPH", "PAGE", "SLIDE", "SLIDE_NOTES", "IMAGE"]},
        "unit_index": {"type": "integer", "minimum": 1},
        "region": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
                "y": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
                "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
              }
            }
          ]
        },
        "character_start": {"const": 0},
        "character_end": {"type": "integer", "minimum": 1}
      }
    },
    "nativeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "text", "text_sha256", "extraction_method", "locator"],
      "properties": {
        "block_id": {"type": "string", "pattern": "^urn:integra:artifact:"},
        "text": {"type": "string", "minLength": 1},
        "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "extraction_method": {"const": "NATIVE"},
        "locator": {"$ref": "#/$defs/locator"}
      }
    },
    "ocrBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "text", "text_sha256", "extraction_method", "locator", "confidence"],
      "properties": {
        "block_id": {"type": "string", "pattern": "^urn:integra:artifact:"},
        "text": {"type": "string", "minLength": 1},
        "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "extraction_method": {"const": "OCR"},
        "locator": {"$ref": "#/$defs/locator"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "nativeExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "text_characters", "blocks"],
      "properties": {
        "status": {"enum": ["COMPLETE", "PARTIAL_UNSUPPORTED_ENCODING", "NOT_APPLICABLE"]},
        "text_characters": {"type": "integer", "minimum": 0},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/nativeBlock"}}
      }
    },
    "ocrExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "provider", "blocks"],
      "properties": {
        "status": {"enum": ["NOT_REQUIRED", "REQUIRED", "COMPLETE"]},
        "reason": {"enum": ["NONE", "IMAGE_SOURCE", "IMAGE_HEAVY_PDF", "IMAGE_HEAVY_DOCUMENT", "UNSUPPORTED_PDF_TEXT_ENCODING"]},
        "provider": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["component_id", "implementation_sha256", "model_id", "model_sha256"],
              "properties": {
                "component_id": {"type": "string", "minLength": 1},
                "implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "model_id": {"type": "string", "minLength": 1},
                "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          ]
        },
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/ocrBlock"}}
      }
    },
    "embeddedMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_id", "part_path", "media_type", "sha256", "size_bytes", "parent_locator", "source_sha256"],
      "properties": {
        "media_id": {"type": "string", "pattern": "^urn:integra:artifact:"},
        "part_path": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "parent_locator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit_kind", "unit_index"],
          "properties": {
            "unit_kind": {"enum": ["DOCUMENT", "PRESENTATION", "PDF_OBJECT"]},
            "unit_index": {"type": "integer", "minimum": 1}
          }
        },
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
