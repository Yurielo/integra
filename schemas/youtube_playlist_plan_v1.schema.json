{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.local/schemas/youtube_playlist_plan_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "job_id", "collection_id", "snapshot_id",
    "snapshot_sha256", "plan_sha256", "selected_video_ids", "items",
    "execution", "storage_estimate"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "plan_id": { "type": "string", "pattern": "^urn:integra:operation:" },
    "job_id": { "type": "string", "pattern": "^urn:integra:job:" },
    "collection_id": { "type": "string", "pattern": "^urn:integra:source:" },
    "snapshot_id": { "type": "string", "pattern": "^urn:integra:artifact:" },
    "snapshot_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "selected_video_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "items": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": [
        "collection_kind", "sequential", "max_parallel_items",
        "completed_item_policy", "inaccessible_item_policy"
      ],
      "properties": {
        "collection_kind": { "const": "PLAYLIST" },
        "sequential": { "const": true },
        "max_parallel_items": { "const": 1 },
        "completed_item_policy": { "const": "SKIP_VERIFIED" },
        "inaccessible_item_policy": { "const": "RECORD_AND_CONTINUE" }
      }
    },
    "storage_estimate": { "$ref": "#/$defs/storage" }
  },
  "$defs": {
    "item": {
      "type": "object", "additionalProperties": false,
      "required": [
        "video_id", "position", "title", "availability", "duration_seconds",
        "estimated_download_bytes", "video_source_id"
      ],
      "properties": {
        "video_id": { "type": "string", "minLength": 1 },
        "position": { "type": "integer", "minimum": 0 },
        "title": { "type": "string", "minLength": 1 },
        "availability": { "enum": ["AVAILABLE", "INACCESSIBLE"] },
        "duration_seconds": { "type": "integer", "minimum": 0 },
        "estimated_download_bytes": { "type": "integer", "minimum": 0 },
        "video_source_id": { "type": "string", "pattern": "^urn:integra:source:" }
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source", "extracted_audio", "cache", "intermediate_media",
        "final_output", "safety_margin", "required_disk_bytes"
      ],
      "properties": {
        "source": { "type": "integer", "minimum": 0 },
        "extracted_audio": { "type": "integer", "minimum": 0 },
        "cache": { "type": "integer", "minimum": 0 },
        "intermediate_media": { "type": "integer", "minimum": 0 },
        "final_output": { "type": "integer", "minimum": 0 },
        "safety_margin": { "type": "integer", "minimum": 0 },
        "required_disk_bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
