{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.local/schemas/media_capability_report_v1.schema.json",
  "title": "Integra VideoText Media Capability Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "component",
    "capabilities",
    "models",
    "runtime_probe",
    "runtime_probe_sha256",
    "implementation_probe_sha256",
    "measured_at",
    "report_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "READY"
    },
    "component": {
      "const": {
        "component_id": "videotext",
        "repository": "Yurielo/videotext",
        "commit_sha": "2e098d1705b6815628bee1e023f4742718eabf02",
        "tree_sha": "f5ec484df90e4db655d31b4174434c37f4d1491c",
        "version": "0.6.4",
        "contracts": [
          "project_schema_v7",
          "project_store_v7",
          "build_identity_0_6_4"
        ],
        "runtime": {
          "kind": "swift",
          "version": "6"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "implementations",
          "status"
        ],
        "properties": {
          "kind": {
            "enum": [
              "clip",
              "subtitles",
              "translation",
              "tts",
              "speed",
              "blur",
              "watermark",
              "audio_enhancement",
              "filler_mute",
              "qa"
            ]
          },
          "implementations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/implementation"
            }
          },
          "status": {
            "const": "PINNED_CONTRACT"
          }
        }
      }
    },
    "models": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "identity_sha256",
          "residency_id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "identity_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "residency_id": {
            "type": "string",
            "pattern": "^media:[0-9a-f]{64}$"
          },
          "status": {
            "const": "MEASURED_AVAILABLE"
          }
        }
      }
    },
    "runtime_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "executable_sha256",
        "probe_arguments_sha256"
      ],
      "properties": {
        "id": {
          "const": "ffprobe"
        },
        "version": {
          "type": "string",
          "pattern": "^ffprobe version .+$"
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "probe_arguments_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "runtime_probe_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "implementation_probe_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "measured_at": {
      "type": "string",
      "format": "date-time"
    },
    "report_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "function",
        "path",
        "sha256"
      ],
      "properties": {
        "function": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
