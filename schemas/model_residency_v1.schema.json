{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.local/schemas/model_residency_v1.schema.json",
  "title": "Integra Model Residency v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "job_id", "operation_id", "state", "acquired_at", "released_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "model_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:/@-]{1,256}$"},
    "job_id": {"type": "string", "pattern": "^urn:integra:job:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "operation_id": {"type": "string", "pattern": "^urn:integra:operation:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "state": {"enum": ["LOADING", "ACTIVE", "RECOVERY_REQUIRED", "RELEASED"]},
    "acquired_at": {"type": "string", "format": "date-time"},
    "released_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["LOADING", "ACTIVE", "RECOVERY_REQUIRED"]}}},
      "then": {"properties": {"released_at": {"type": "null"}}}
    },
    {
      "if": {"properties": {"state": {"const": "RELEASED"}}},
      "then": {"properties": {"released_at": {"type": "string", "format": "date-time"}}}
    }
  ]
}
