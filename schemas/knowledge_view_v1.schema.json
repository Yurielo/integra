{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yurielo/integra/schemas/knowledge_view_v1.schema.json",
  "title": "Integra read-governed Knowledge View v1",
  "type": "object",
  "required": [
    "schema_version",
    "view_id",
    "source_binding",
    "created_at",
    "semantic_authority",
    "source_artifacts_modified",
    "records",
    "terms",
    "evidence",
    "graph",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "view_id": {
      "$ref": "#/$defs/urn"
    },
    "source_binding": {
      "type": "object",
      "required": [
        "component_id",
        "commit_sha",
        "tree_sha",
        "component_identity_sha256",
        "contract_sha256",
        "canonical_evidence_id",
        "canonical_evidence_sha256",
        "canonical_evidence_content_sha256",
        "source_evidence_id",
        "source_evidence_sha256",
        "source_evidence_content_sha256",
        "canonical_knowledge_id",
        "canonical_knowledge_sha256",
        "canonical_knowledge_content_sha256"
      ],
      "properties": {
        "component_id": {
          "const": "seminartext"
        },
        "commit_sha": {
          "const": "970bde598ddd649599295139986933e0e06cb9c0"
        },
        "tree_sha": {
          "const": "6384533c5a41dc97e9fa36f57e7240ac825e411c"
        },
        "component_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "contract_sha256": {
          "type": "object",
          "required": [
            "canonical_evidence_v1",
            "canonical_knowledge_v1",
            "canonical_knowledge_lifecycle",
            "canonical_evidence_validator",
            "canonical_knowledge_validator"
          ],
          "properties": {
            "canonical_evidence_v1": {
              "const": "08bab4381ba435a059a1b58ea5dbedadd57112a18421ea7ef84a10ddb52d44b8"
            },
            "canonical_knowledge_v1": {
              "const": "33691770411b4e5fc4e923920619396f7281bcd655202f8f56ddba99b844111b"
            },
            "canonical_knowledge_lifecycle": {
              "const": "c9133fe6ff630dd44475f40d37d731f407ce2f79d1d15613454a1d5c179099bc"
            },
            "canonical_evidence_validator": {
              "const": "889e6cdf3dc2dd7504f76923c04e2d8d1eceabdb828d0c110ddc1059b107860e"
            },
            "canonical_knowledge_validator": {
              "const": "14869b0d77bed839758afb0455cffcfcba4173495554eddd9159a02309f1c095"
            }
          },
          "additionalProperties": false
        },
        "canonical_evidence_id": {
          "$ref": "#/$defs/source_id"
        },
        "canonical_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_evidence_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_evidence_id": {
          "$ref": "#/$defs/source_id"
        },
        "source_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_evidence_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_knowledge_id": {
          "$ref": "#/$defs/source_id"
        },
        "canonical_knowledge_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_knowledge_content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "semantic_authority": {
      "const": "READ_ONLY_SOURCE_LIFECYCLE"
    },
    "source_artifacts_modified": {
      "const": false
    },
    "records": {
      "type": "object",
      "required": [
        "seminars",
        "topics",
        "concepts",
        "relations",
        "review_decisions"
      ],
      "properties": {
        "seminars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_seminar"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_topic"
          }
        },
        "concepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_concept"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_relation"
          }
        },
        "review_decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_review_decision"
          }
        }
      },
      "additionalProperties": false
    },
    "terms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/term"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "graph": {
      "$ref": "#/$defs/graph"
    },
    "record_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "urn": {
      "type": "string",
      "pattern": "^urn:integra:[a-z][a-z0-9_]{1,31}:[0-9a-f-]{36}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "term": {
      "type": "object",
      "required": [
        "term_id",
        "concept_id",
        "kind",
        "value",
        "semantic_status",
        "evidence_refs",
        "traceability",
        "term_sha256"
      ],
      "properties": {
        "term_id": {
          "$ref": "#/$defs/urn"
        },
        "concept_id": {
          "$ref": "#/$defs/source_id"
        },
        "kind": {
          "enum": [
            "PREFERRED_LABEL",
            "SOURCE_ALIAS"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "semantic_status": {
          "enum": [
            "PROVISIONAL",
            "ACCEPTED",
            "REJECTED",
            "SUPERSEDED"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "traceability": {
          "enum": [
            "LITERAL_SOURCE_EVIDENCE",
            "CONCEPT_SEMANTIC_EVIDENCE"
          ]
        },
        "term_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "claim",
        "source_id",
        "transcript_revision_id",
        "word_start_id",
        "word_end_id",
        "quote",
        "locator",
        "timing_status",
        "unaligned_word_ids",
        "transcript_assurance",
        "evidence_sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/source_id"
        },
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "transcript_revision_id": {
          "$ref": "#/$defs/source_id"
        },
        "word_start_id": {
          "$ref": "#/$defs/source_id"
        },
        "word_end_id": {
          "$ref": "#/$defs/source_id"
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "object",
          "required": [
            "type",
            "start_seconds",
            "end_seconds"
          ],
          "properties": {
            "type": {
              "const": "time_interval"
            },
            "start_seconds": {
              "type": "number",
              "minimum": 0
            },
            "end_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "timing_status": {
          "enum": [
            "aligned_word_range",
            "aligned_envelope_with_explicit_unaligned_words"
          ]
        },
        "unaligned_word_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "transcript_assurance": {
          "type": "object",
          "required": [
            "revision_kind",
            "authority",
            "lifecycle_status",
            "provenance"
          ],
          "properties": {
            "revision_kind": {
              "enum": [
                "asr",
                "verified",
                "corrected"
              ]
            },
            "authority": {
              "enum": [
                "candidate",
                "authoritative",
                "superseded"
              ]
            },
            "lifecycle_status": {
              "$ref": "#/$defs/ce_lifecycle"
            },
            "provenance": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ce_transcriptProvenance"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "status",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 3
            },
            "kind": {
              "enum": [
                "SEMINAR",
                "TOPIC",
                "CONCEPT",
                "RELATION",
                "TERM"
              ]
            },
            "status": {
              "enum": [
                "PROVISIONAL",
                "ACCEPTED",
                "REJECTED",
                "SUPERSEDED"
              ]
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "status",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 3
            },
            "kind": {
              "enum": [
                "REVIEW_DECISION"
              ]
            },
            "status": {
              "enum": [
                "DECISION"
              ]
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "kind",
            "status",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 3
            },
            "kind": {
              "enum": [
                "EVIDENCE"
              ]
            },
            "status": {
              "enum": [
                "SOURCE_EVIDENCE"
              ]
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "edge": {
      "type": "object",
      "required": [
        "from_id",
        "to_id",
        "kind"
      ],
      "properties": {
        "from_id": {
          "type": "string",
          "minLength": 3
        },
        "to_id": {
          "type": "string",
          "minLength": 3
        },
        "kind": {
          "enum": [
            "SUPPORTED_BY",
            "MENTIONS",
            "RELATION_SOURCE",
            "RELATION_TARGET",
            "CONTAINS",
            "TERM_OF",
            "REVIEW_TARGET",
            "REVIEW_RESULT"
          ]
        }
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "required": [
        "nodes",
        "edges",
        "graph_sha256"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "graph_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "ck_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "ck_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ck_status": {
      "enum": [
        "PROVISIONAL",
        "ACCEPTED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "ck_version": {
      "type": "integer",
      "minimum": 1
    },
    "ck_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "source_artifact_id"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "canonical_evidence",
            "golden_slice",
            "human_review",
            "derived"
          ]
        },
        "source_artifact_id": {
          "$ref": "#/$defs/ck_id"
        },
        "source_status": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "ck_artifact_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "schema_version",
        "sha256",
        "path"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ck_id"
        },
        "schema_version": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/ck_sha256"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!~)(?![A-Za-z]:[\\\\/])[^\\u0000]+$"
        }
      }
    },
    "ck_project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "version",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ck_id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/ck_status"
        },
        "version": {
          "$ref": "#/$defs/ck_version"
        },
        "provenance": {
          "$ref": "#/$defs/ck_provenance"
        }
      }
    },
    "ck_seminar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project_id",
        "title",
        "status",
        "version",
        "provenance",
        "topic_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ck_id"
        },
        "project_id": {
          "$ref": "#/$defs/ck_id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/ck_status"
        },
        "version": {
          "$ref": "#/$defs/ck_version"
        },
        "provenance": {
          "$ref": "#/$defs/ck_provenance"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_id"
          }
        },
        "topic_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_id"
          }
        }
      }
    },
    "ck_source_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ids",
        "transcript_revision_ids"
      ],
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_id"
          }
        },
        "transcript_revision_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_id"
          }
        },
        "order_start": {
          "type": "integer",
          "minimum": 0
        },
        "order_end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ck_topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "seminar_id",
        "source_scope",
        "title",
        "summary",
        "evidence_refs",
        "concept_refs",
        "status",
        "provenance",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ck_id"
        },
        "seminar_id": {
          "$ref": "#/$defs/ck_id"
        },
        "source_scope": {
          "$ref": "#/$defs/ck_source_scope"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "temporal_scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_seconds": {
              "type": "number",
              "minimum": 0
            },
            "end_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "order_scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_id"
          }
        },
        "concept_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_id"
          }
        },
        "status": {
          "$ref": "#/$defs/ck_status"
        },
        "provenance": {
          "$ref": "#/$defs/ck_provenance"
        },
        "version": {
          "$ref": "#/$defs/ck_version"
        }
      }
    },
    "ck_concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "preferred_label",
        "aliases",
        "status",
        "scope",
        "description",
        "provenance",
        "evidence_refs",
        "topic_refs",
        "version",
        "created_from",
        "supersedes",
        "redirects"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ck_id"
        },
        "preferred_label": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/ck_status"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/ck_provenance"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_id"
          }
        },
        "topic_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_id"
          }
        },
        "version": {
          "$ref": "#/$defs/ck_version"
        },
        "created_from": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_id"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_id"
          }
        },
        "redirects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_id"
          }
        }
      }
    },
    "ck_relation_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "supports",
            "contradicts",
            "refines",
            "depends_on",
            "associated_with"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ck_relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_concept_id",
        "target_concept_id",
        "relation_type",
        "status",
        "provenance",
        "evidence_refs",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ck_id"
        },
        "source_concept_id": {
          "$ref": "#/$defs/ck_id"
        },
        "target_concept_id": {
          "$ref": "#/$defs/ck_id"
        },
        "relation_type": {
          "type": "string",
          "enum": [
            "supports",
            "contradicts",
            "refines",
            "depends_on",
            "associated_with"
          ]
        },
        "status": {
          "$ref": "#/$defs/ck_status"
        },
        "provenance": {
          "$ref": "#/$defs/ck_provenance"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_id"
          }
        },
        "version": {
          "$ref": "#/$defs/ck_version"
        }
      }
    },
    "ck_review_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "target_ids",
        "result_ids",
        "reason",
        "actor_type",
        "timestamp",
        "input_version",
        "output_version",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ck_id"
        },
        "action": {
          "type": "string",
          "enum": [
            "ACCEPT",
            "RENAME",
            "SPLIT",
            "MERGE",
            "REJECT",
            "DEFER"
          ]
        },
        "target_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ck_id"
          }
        },
        "result_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_id"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "actor_type": {
          "type": "string",
          "enum": [
            "human_domain_reviewer",
            "product_owner",
            "system_validator"
          ]
        },
        "actor_id": {
          "$ref": "#/$defs/ck_id"
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "input_version": {
          "$ref": "#/$defs/ck_version"
        },
        "output_version": {
          "$ref": "#/$defs/ck_version"
        },
        "provenance": {
          "$ref": "#/$defs/ck_provenance"
        },
        "source_revision": {
          "$ref": "#/$defs/ck_id"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ck_id"
          }
        }
      }
    },
    "ce_verificationRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "char_start",
        "char_end"
      ],
      "properties": {
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ce_transcriptProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "method",
        "verification_state",
        "verification_ranges",
        "reviewer"
      ],
      "properties": {
        "origin": {
          "enum": [
            "machine_generated",
            "human_verified",
            "human_corrected"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "verification_state": {
          "enum": [
            "machine_unverified",
            "selectively_verified",
            "fully_human_verified"
          ]
        },
        "verification_ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ce_verificationRange"
          }
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "ce_lifecycle": {
      "enum": [
        "draft",
        "active",
        "verified",
        "superseded",
        "invalidated",
        "archived"
      ]
    }
  }
}
