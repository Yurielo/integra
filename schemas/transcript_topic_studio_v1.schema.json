{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yurielo/integra/schemas/transcript_topic_studio_v1.schema.json",
  "title": "Integra Transcript and Topic Studio v1",
  "type": "object",
  "required": [
    "schema_version", "studio_id", "project_id", "registry_binding", "source", "created_at",
    "updated_at", "revision", "status", "component_bindings", "artifacts",
    "quality_findings", "topic_sets", "hierarchies", "review_packages",
    "review_decisions", "semantic_authority", "cross_source_alignment",
    "source_artifacts_modified", "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "studio_id": {"$ref": "#/$defs/urn"},
    "project_id": {"$ref": "#/$defs/urn"},
    "registry_binding": {
      "type": "object",
      "required": ["registry_id", "registry_record_sha256", "project_record_sha256", "source_record_sha256"],
      "properties": {
        "registry_id": {"$ref": "#/$defs/urn"},
        "registry_record_sha256": {"$ref": "#/$defs/sha256"},
        "project_record_sha256": {"$ref": "#/$defs/sha256"},
        "source_record_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["source_id", "source_revision_id", "source_revision_sha256", "source_type", "source_binding_sha256"],
      "properties": {
        "source_id": {"$ref": "#/$defs/urn"},
        "source_revision_id": {"$ref": "#/$defs/urn"},
        "source_revision_sha256": {"$ref": "#/$defs/sha256"},
        "source_type": {"enum": ["LOCAL_VIDEO", "LOCAL_AUDIO", "YOUTUBE_VIDEO", "YOUTUBE_PLAYLIST", "PDF", "PPTX", "DOCX", "TXT", "MARKDOWN", "IMAGE", "SCAN"]},
        "source_binding_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 0},
    "status": {"enum": ["ACTIVE", "CANCELLED"]},
    "component_bindings": {
      "type": "object",
      "required": ["media_preparation", "asr", "translation", "word_timeline", "topics", "review_mechanics", "quality_validation"],
      "properties": {
        "media_preparation": {"$ref": "#/$defs/binding"},
        "asr": {"$ref": "#/$defs/binding"},
        "translation": {"$ref": "#/$defs/binding"},
        "word_timeline": {"$ref": "#/$defs/binding"},
        "topics": {"$ref": "#/$defs/binding"},
        "review_mechanics": {"$ref": "#/$defs/binding"},
        "quality_validation": {"$ref": "#/$defs/binding"}
      },
      "additionalProperties": false
    },
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "quality_findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "topic_sets": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/topic_set"}},
    "hierarchies": {"type": "array", "items": {"$ref": "#/$defs/hierarchy"}},
    "review_packages": {"type": "array", "items": {"$ref": "#/$defs/review_package"}},
    "review_decisions": {"type": "array", "items": {"$ref": "#/$defs/review_decision"}},
    "semantic_authority": {"const": "MACHINE_OUTPUT_REQUIRES_HUMAN_DECISION"},
    "cross_source_alignment": {"const": "OUT_OF_SCOPE_R8C"},
    "source_artifacts_modified": {"const": false},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "urn": {"type": "string", "pattern": "^urn:integra:[a-z][a-z0-9_]{1,31}:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "component": {
      "type": "object",
      "required": ["component_id", "commit_sha", "contract_id", "model_id", "model_sha256"],
      "properties": {
        "component_id": {"enum": ["seminartext", "videotext", "integra.translation"]},
        "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "contract_id": {"enum": ["canonical_evidence_v1", "canonical_knowledge_v1", "topic_review_workflow_v2", "project_schema_v7", "project_store_v7", "build_identity_0_6_4", "integra_translation_v1"]},
        "model_id": {"type": ["string", "null"]},
        "model_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"component_id": {"const": "seminartext"}}}, "then": {"properties": {"commit_sha": {"const": "a94936cd77cde13561c97c804ece1ac1134e01a6"}, "contract_id": {"enum": ["canonical_evidence_v1", "canonical_knowledge_v1", "topic_review_workflow_v2"]}}}},
        {"if": {"properties": {"component_id": {"const": "videotext"}}}, "then": {"properties": {"commit_sha": {"const": "2e098d1705b6815628bee1e023f4742718eabf02"}, "contract_id": {"enum": ["project_schema_v7", "project_store_v7", "build_identity_0_6_4"]}}}},
        {"if": {"properties": {"component_id": {"const": "integra.translation"}}}, "then": {"properties": {"contract_id": {"const": "integra_translation_v1"}, "model_id": {"const": "translategemma:4b-it-q4_K_M"}, "model_sha256": {"const": "c49d986b0764f5881c476eb21435bb62b7abc62347aab3d4a6071e811be510a1"}}}}
      ],
      "oneOf": [
        {"properties": {"model_id": {"const": "translategemma:4b-it-q4_K_M"}, "model_sha256": {"const": "c49d986b0764f5881c476eb21435bb62b7abc62347aab3d4a6071e811be510a1"}}},
        {"properties": {"model_id": {"type": "null"}, "model_sha256": {"type": "null"}}},
        {"properties": {"model_id": {"const": "ggml-large-v3.bin"}, "model_sha256": {"const": "64d182b440b98d5203c4f9bd541544d84c605196c4f7b845dfa11fb23594d1e2"}}},
        {"properties": {"model_id": {"const": "gemma3:4b"}, "model_sha256": {"const": "ed1e8a40017e648c133188919a5a0105ce1916726dbc657fecb5ccb5d717c46d"}}},
        {"properties": {"model_id": {"const": "gemma3:4b:manifest"}, "model_sha256": {"const": "a2af6cc3eb7fa8be8504abaf9b04e88f17a119ec3f04a3addf55f92841195f5a"}}},
        {"properties": {"model_id": {"const": "gemma3:4b:weights"}, "model_sha256": {"const": "aeda25e63ebd698fab8638ffb778e68bed908b960d39d0becc650fa981609d25"}}}
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["capability", "components", "config_sha256", "r5_selection_sha256"],
      "properties": {
        "capability": {"enum": ["media_preparation", "asr", "translation", "word_timeline", "topics", "review_mechanics", "quality_validation"]},
        "components": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/component"}},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "r5_selection_sha256": {"const": "38ec6db0172c6bd61d8515b71c32be0554e311684364758cf87c598723dc20c3"}
      },
      "additionalProperties": false
    },
    "locator": {
      "oneOf": [
        {"type": "object", "required": ["type", "start_seconds", "end_seconds"], "properties": {"type": {"const": "TIME_INTERVAL"}, "start_seconds": {"type": "number", "minimum": 0}, "end_seconds": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "start_word_id", "end_word_id", "start_sequence", "end_sequence"], "properties": {"type": {"const": "WORD_INTERVAL"}, "start_word_id": {"type": "string", "minLength": 1}, "end_word_id": {"type": "string", "minLength": 1}, "start_sequence": {"type": "integer", "minimum": 0}, "end_sequence": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "start_page", "end_page"], "properties": {"type": {"const": "PAGE_RANGE"}, "start_page": {"type": "integer", "minimum": 1}, "end_page": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "start_slide", "end_slide"], "properties": {"type": {"const": "SLIDE_RANGE"}, "start_slide": {"type": "integer", "minimum": 1}, "end_slide": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "container_type", "container_index", "x", "y", "width", "height"], "properties": {"type": {"const": "REGION"}, "container_type": {"enum": ["PAGE", "SLIDE", "IMAGE"]}, "container_index": {"type": "integer", "minimum": 1}, "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "start_char", "end_char"], "properties": {"type": {"const": "CHARACTER_RANGE"}, "start_char": {"type": "integer", "minimum": 0}, "end_char": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "artifact_id", "revision_id", "content_sha256"], "properties": {"type": {"const": "ARTIFACT_REVISION"}, "artifact_id": {"$ref": "#/$defs/urn"}, "revision_id": {"$ref": "#/$defs/urn"}, "content_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}
      ]
    },
    "artifact": {
      "type": "object",
      "required": ["artifact_id", "native_id", "kind", "content_sha256", "created_at", "capability", "component_binding_sha256", "parent_ids", "locators", "semantic_status", "metadata", "metadata_sha256"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/urn"},
        "native_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["MEDIA_PREPARATION", "MACHINE_TRANSCRIPT", "TRANSLATION", "WORD_TIMELINE", "QUALITY_REPORT", "TOPIC_SET", "TOPIC_HIERARCHY"]},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "created_at": {"type": "string", "format": "date-time"},
        "capability": {"type": "string", "minLength": 1},
        "component_binding_sha256": {"$ref": "#/$defs/sha256"},
        "parent_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/urn"}},
        "locators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locator"}},
        "semantic_status": {"enum": ["NOT_APPLICABLE", "PROVISIONAL", "REVIEW_REQUIRED"]},
        "metadata": {"type": "object"},
        "metadata_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["finding_id", "native_id", "artifact_id", "code", "severity", "confidence", "locators", "detail", "created_at", "review_required", "finding_sha256"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/urn"},
        "native_id": {"type": "string", "minLength": 1},
        "artifact_id": {"$ref": "#/$defs/urn"},
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["INFO", "WARN", "ERROR"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "locators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locator"}},
        "detail": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "review_required": {"type": "boolean"},
        "finding_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "topic": {
      "type": "object",
      "required": ["topic_id", "native_id", "topic_set_id", "level", "sequence", "title", "summary", "confidence", "conflict", "semantic_status", "locators", "evidence_refs"],
      "properties": {
        "topic_id": {"$ref": "#/$defs/urn"},
        "native_id": {"type": "string", "minLength": 1},
        "topic_set_id": {"$ref": "#/$defs/urn"},
        "level": {"enum": ["DETAILED", "NORMAL", "COARSE"]},
        "sequence": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "conflict": {"type": "boolean"},
        "semantic_status": {"enum": ["PROVISIONAL", "REVIEW_REQUIRED"]},
        "locators": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/locator"}},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "topic_set": {
      "type": "object",
      "required": ["topic_set_id", "native_id", "content_sha256", "created_at", "timeline_id", "level", "semantic_status", "component_binding_sha256", "topics", "payload_sha256"],
      "properties": {
        "topic_set_id": {"$ref": "#/$defs/urn"},
        "native_id": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "created_at": {"type": "string", "format": "date-time"},
        "timeline_id": {"$ref": "#/$defs/urn"},
        "level": {"enum": ["DETAILED", "NORMAL", "COARSE"]},
        "semantic_status": {"enum": ["PROVISIONAL", "REVIEW_REQUIRED"]},
        "component_binding_sha256": {"$ref": "#/$defs/sha256"},
        "topics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/topic"}},
        "payload_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "hierarchy": {
      "type": "object",
      "required": ["hierarchy_id", "native_id", "created_at", "content_sha256", "semantic_status", "edges"],
      "properties": {
        "hierarchy_id": {"$ref": "#/$defs/urn"},
        "native_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_status": {"const": "PROVISIONAL"},
        "edges": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["child_topic_id", "parent_topic_id"], "properties": {"child_topic_id": {"$ref": "#/$defs/urn"}, "parent_topic_id": {"$ref": "#/$defs/urn"}}, "additionalProperties": false}}
      },
      "additionalProperties": false
    },
    "review_package": {
      "type": "object",
      "required": ["package_id", "native_id", "created_at", "status", "scope_sha256", "member_ids", "neighbor_topic_ids", "member_bindings", "neighbor_bindings", "source_revision_id"],
      "properties": {
        "package_id": {"$ref": "#/$defs/urn"},
        "native_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["REVIEW_REQUIRED", "DECIDED"]},
        "scope_sha256": {"$ref": "#/$defs/sha256"},
        "member_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/urn"}},
        "neighbor_topic_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/urn"}},
        "member_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["member_id", "content_sha256"], "properties": {"member_id": {"$ref": "#/$defs/urn"}, "content_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}},
        "neighbor_bindings": {"type": "array", "items": {"type": "object", "required": ["topic_id", "content_sha256"], "properties": {"topic_id": {"$ref": "#/$defs/urn"}, "content_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}},
        "source_revision_id": {"$ref": "#/$defs/urn"},
        "decision_id": {"$ref": "#/$defs/urn"}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "DECIDED"}}}, "then": {"required": ["decision_id"]}}],
      "additionalProperties": false
    },
    "review_decision": {
      "type": "object",
      "required": ["decision_id", "native_id", "package_id", "scope_sha256", "authority", "decided_at", "lease_id", "lease_generation", "lease_operation_id", "resolutions", "decision_sha256", "source_artifacts_modified"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/urn"},
        "native_id": {"type": "string", "minLength": 1},
        "package_id": {"$ref": "#/$defs/urn"},
        "scope_sha256": {"$ref": "#/$defs/sha256"},
        "authority": {"const": "HUMAN_DOMAIN_REVIEW"},
        "decided_at": {"type": "string", "format": "date-time"},
        "lease_id": {"$ref": "#/$defs/urn"},
        "lease_generation": {"type": "integer", "minimum": 1},
        "lease_operation_id": {"$ref": "#/$defs/urn"},
        "resolutions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["member_id", "resolution", "decision_payload_sha256"], "properties": {"member_id": {"$ref": "#/$defs/urn"}, "resolution": {"enum": ["ACCEPT", "REJECT", "ADJUST"]}, "decision_payload_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}},
        "decision_sha256": {"$ref": "#/$defs/sha256"},
        "source_artifacts_modified": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
