{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yurielo/integra/schemas/multi_source_alignment_v1.schema.json",
  "title": "Integra Multi-source Alignment v1",
  "type": "object",
  "required": ["schema_version", "alignment_id", "project_id", "registry_binding", "sources", "artifact_catalog", "created_at", "updated_at", "revision", "nodes", "links", "semantic_authority", "source_artifacts_modified", "record_sha256"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "alignment_id": {"$ref": "#/$defs/urn"},
    "project_id": {"$ref": "#/$defs/urn"},
    "registry_binding": {
      "type": "object",
      "required": ["registry_id", "registry_record_sha256", "project_record_sha256"],
      "properties": {
        "registry_id": {"$ref": "#/$defs/urn"},
        "registry_record_sha256": {"$ref": "#/$defs/sha256"},
        "project_record_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "sources": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}},
    "artifact_catalog": {
      "type": "object",
      "required": ["schema_version", "upstream_record_bindings", "references", "catalog_sha256"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "upstream_record_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/upstream_record_binding"}},
        "references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/catalog_reference"}},
        "catalog_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "revision": {"type": "integer", "minimum": 0},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "semantic_authority": {"const": "MACHINE_ALIGNMENT_REQUIRES_HUMAN_DECISION"},
    "source_artifacts_modified": {"const": false},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "urn": {"type": "string", "pattern": "^urn:integra:[a-z][a-z0-9_]{1,31}:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "source": {
      "type": "object",
      "required": ["source_id", "source_revision_id", "source_revision_sha256", "source_type", "source_record_sha256"],
      "properties": {
        "source_id": {"$ref": "#/$defs/urn"},
        "source_revision_id": {"$ref": "#/$defs/urn"},
        "source_revision_sha256": {"$ref": "#/$defs/sha256"},
        "source_type": {"enum": ["LOCAL_VIDEO", "LOCAL_AUDIO", "YOUTUBE_VIDEO", "YOUTUBE_PLAYLIST", "PDF", "PPTX", "DOCX", "TXT", "MARKDOWN", "IMAGE", "SCAN"]},
        "source_record_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "upstream_record_binding": {
      "type": "object",
      "required": ["contract", "record_id", "record_sha256"],
      "properties": {
        "contract": {"enum": ["DOCUMENT_EXTRACTION_V1", "TRANSCRIPT_TOPIC_STUDIO_V1"]},
        "record_id": {"$ref": "#/$defs/urn"},
        "record_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "catalog_reference": {
      "type": "object",
      "required": ["artifact_id", "kind", "content_sha256", "semantic_status", "owner_component", "parent_artifact_ids", "source_locator"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/urn"},
        "kind": {"enum": ["VIDEO", "AUDIO", "TRANSCRIPT", "SLIDE", "PAGE", "SUPPORTING_DOCUMENT", "TOPIC", "EVIDENCE"]},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_status": {"enum": ["PROVISIONAL", "REVIEW_REQUIRED", "NOT_APPLICABLE"]},
        "owner_component": {"type": "string", "minLength": 1},
        "parent_artifact_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/urn"}},
        "source_locator": {
          "type": "object",
          "required": ["native_id", "source_id", "source_revision_id", "source_revision_sha256", "upstream_record_id", "upstream_record_sha256", "upstream_entity_id", "locators"],
          "properties": {
            "native_id": {"type": "string", "minLength": 1},
            "source_id": {"$ref": "#/$defs/urn"},
            "source_revision_id": {"$ref": "#/$defs/urn"},
            "source_revision_sha256": {"$ref": "#/$defs/sha256"},
            "upstream_record_id": {"$ref": "#/$defs/urn"},
            "upstream_record_sha256": {"$ref": "#/$defs/sha256"},
            "upstream_entity_id": {"$ref": "#/$defs/urn"},
            "locators": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/locator"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["node_id", "native_id", "kind", "source_id", "source_revision_id", "artifact_id", "artifact_sha256", "owner_component", "locators", "lineage_ids", "semantic_status", "created_at", "node_sha256"],
      "properties": {
        "node_id": {"$ref": "#/$defs/urn"},
        "native_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["VIDEO", "AUDIO", "TRANSCRIPT", "SLIDE", "PAGE", "SUPPORTING_DOCUMENT", "TOPIC", "EVIDENCE"]},
        "source_id": {"$ref": "#/$defs/urn"},
        "source_revision_id": {"$ref": "#/$defs/urn"},
        "artifact_id": {"$ref": "#/$defs/urn"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "owner_component": {"type": "string", "minLength": 1},
        "locators": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/locator"}},
        "lineage_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "semantic_status": {"enum": ["PROVISIONAL", "REVIEW_REQUIRED", "NOT_APPLICABLE"]},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "node_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": ["link_id", "native_id", "relation", "from_node_id", "from_node_sha256", "to_node_id", "to_node_sha256", "evidence", "method", "confidence", "conflict", "semantic_status", "created_at", "scope_sha256"],
      "properties": {
        "link_id": {"$ref": "#/$defs/urn"},
        "native_id": {"type": "string", "minLength": 1},
        "relation": {"enum": ["VIDEO_TO_TRANSCRIPT", "VIDEO_TO_SLIDE", "TOPIC_TO_PAGE", "TOPIC_TO_SLIDE", "EVIDENCE_TO_DOCUMENT"]},
        "from_node_id": {"$ref": "#/$defs/urn"},
        "from_node_sha256": {"$ref": "#/$defs/sha256"},
        "to_node_id": {"$ref": "#/$defs/urn"},
        "to_node_sha256": {"$ref": "#/$defs/sha256"},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_binding"}},
        "method": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "conflict": {"type": "boolean"},
        "semantic_status": {"enum": ["PROVISIONAL", "REVIEW_REQUIRED"]},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "scope_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "evidence_binding": {
      "type": "object",
      "required": ["node_id", "node_sha256"],
      "properties": {"node_id": {"$ref": "#/$defs/urn"}, "node_sha256": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": false
    },
    "locator": {
      "oneOf": [
        {"type": "object", "required": ["type", "start_seconds", "end_seconds"], "properties": {"type": {"const": "TIME_INTERVAL"}, "start_seconds": {"type": "number", "minimum": 0}, "end_seconds": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "start_word_id", "end_word_id", "start_sequence", "end_sequence"], "properties": {"type": {"const": "WORD_INTERVAL"}, "start_word_id": {"type": "string", "minLength": 1}, "end_word_id": {"type": "string", "minLength": 1}, "start_sequence": {"type": "integer", "minimum": 0}, "end_sequence": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "start_page", "end_page"], "properties": {"type": {"const": "PAGE_RANGE"}, "start_page": {"type": "integer", "minimum": 1}, "end_page": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "start_slide", "end_slide"], "properties": {"type": {"const": "SLIDE_RANGE"}, "start_slide": {"type": "integer", "minimum": 1}, "end_slide": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "container_type", "container_index", "x", "y", "width", "height"], "properties": {"type": {"const": "REGION"}, "container_type": {"enum": ["PAGE", "SLIDE", "IMAGE"]}, "container_index": {"type": "integer", "minimum": 1}, "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1}, "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "start_char", "end_char"], "properties": {"type": {"const": "CHARACTER_RANGE"}, "start_char": {"type": "integer", "minimum": 0}, "end_char": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
        {"type": "object", "required": ["type", "artifact_id", "revision_id", "content_sha256"], "properties": {"type": {"const": "ARTIFACT_REVISION"}, "artifact_id": {"$ref": "#/$defs/urn"}, "revision_id": {"$ref": "#/$defs/urn"}, "content_sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}
      ]
    }
  }
}
