{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yurielo/integra/schemas/worker_protocol_v1.schema.json",
  "title": "Integra local worker message v1",
  "type": "object",
  "required": ["protocol_version", "message_id", "correlation_id", "sent_at", "type", "payload"],
  "properties": {
    "protocol_version": { "const": "1.0" },
    "message_id": {
      "type": "string",
      "pattern": "^urn:integra:[a-z][a-z0-9_]{1,31}:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^urn:integra:[a-z][a-z0-9_]{1,31}:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sent_at": { "type": "string", "format": "date-time" },
    "type": {
      "enum": [
        "HANDSHAKE_REQUEST",
        "HANDSHAKE_RESPONSE",
        "JOB_REQUEST",
        "PROGRESS",
        "RESULT",
        "ERROR",
        "CANCEL_REQUEST",
        "CANCEL_ACK"
      ]
    },
    "payload": { "type": "object" }
  },
  "$defs": {
    "urn": {
      "type": "string",
      "pattern": "^urn:integra:[a-z][a-z0-9_]{1,31}:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "resume_token": {
      "type": "object",
      "required": ["token", "binding_sha256", "issued_at", "expires_at"],
      "properties": {
        "token": { "type": "string", "minLength": 1 },
        "binding_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["id", "version", "input_schema_ids", "output_schema_ids", "supports_resume"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "input_schema_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "output_schema_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "supports_resume": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "HANDSHAKE_REQUEST" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["supported_protocol_versions", "requested_capabilities", "controller"],
            "properties": {
              "supported_protocol_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
              "requested_capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
              "controller": { "$ref": "component_identity_v1.schema.json" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "HANDSHAKE_RESPONSE" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["selected_protocol_version", "worker", "capabilities", "compatibility"],
            "properties": {
              "selected_protocol_version": { "const": "1.0" },
              "worker": { "$ref": "component_identity_v1.schema.json" },
              "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" } },
              "compatibility": {
                "type": "object",
                "required": ["schema_policy", "backward_compatible_protocol_versions"],
                "properties": {
                  "schema_policy": { "const": "EXACT_SCHEMA_VERSION" },
                  "backward_compatible_protocol_versions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "JOB_REQUEST" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["job_id", "operation_id", "idempotency_key", "capability", "timeout_ms", "inputs"],
            "properties": {
              "job_id": { "$ref": "#/$defs/urn" },
              "operation_id": { "$ref": "#/$defs/urn" },
              "idempotency_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "capability": { "type": "string", "minLength": 1 },
              "timeout_ms": { "type": "integer", "minimum": 1 },
              "inputs": { "type": "array", "items": { "$ref": "artifact_reference_v1.schema.json" } },
              "resume_token": { "$ref": "#/$defs/resume_token" },
              "mutable_entity": { "$ref": "#/$defs/urn" },
              "write_lease": {
                "type": "object",
                "required": ["lease_id", "generation", "artifact_precondition_sha256"],
                "properties": {
                  "lease_id": { "$ref": "#/$defs/urn" },
                  "generation": { "type": "integer", "minimum": 1 },
                  "artifact_precondition_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "PROGRESS" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["job_id", "sequence", "fraction", "stage"],
            "properties": {
              "job_id": { "$ref": "#/$defs/urn" },
              "sequence": { "type": "integer", "minimum": 0 },
              "fraction": { "type": "number", "minimum": 0, "maximum": 1 },
              "stage": { "type": "string", "minLength": 1 },
              "eta_ms": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "RESULT" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["job_id", "operation_id", "status", "outputs"],
            "properties": {
              "job_id": { "$ref": "#/$defs/urn" },
              "operation_id": { "$ref": "#/$defs/urn" },
              "status": { "const": "SUCCEEDED" },
              "outputs": { "type": "array", "items": { "$ref": "artifact_reference_v1.schema.json" } }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "ERROR" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["job_id", "code", "message", "classification", "safe_to_retry"],
            "properties": {
              "job_id": { "$ref": "#/$defs/urn" },
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "classification": { "enum": ["RETRYABLE", "NON_RETRYABLE", "INCOMPATIBLE", "CANCELLED", "UNKNOWN_OUTCOME"] },
              "safe_to_retry": { "type": "boolean" },
              "retry_after_ms": { "type": "integer", "minimum": 1 },
              "details": { "type": "object" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "CANCEL_REQUEST" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["job_id"],
            "properties": {
              "job_id": { "$ref": "#/$defs/urn" },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "CANCEL_ACK" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": ["job_id", "status"],
            "properties": {
              "job_id": { "$ref": "#/$defs/urn" },
              "status": { "enum": ["CANCELLED", "ALREADY_TERMINAL", "NOT_FOUND"] }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
