{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yurielo/integra/schemas/migration_plan_v1.schema.json",
  "title": "Integra copy-on-write migration dry-run plan v1",
  "type": "object",
  "required": [
    "schema_version", "plan_id", "job_id", "source_discovery_id",
    "source_component", "project_id", "source_root", "target_root",
    "target_parent", "target_locator_sha256", "source_revision_sha256", "source_layout_sha256",
    "plan_sha256", "status", "block_reasons", "mode", "activation",
    "collision_policy", "source_write_operations", "mappings"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^urn:integra:operation:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "job_id": {"type": "string", "pattern": "^urn:integra:job:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "source_discovery_id": {"type": "string", "pattern": "^urn:integra:operation:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "source_component": {"enum": ["seminartext", "videotext"]},
    "project_id": {"type": "string", "pattern": "^urn:integra:project:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "source_root": {"type": "string", "minLength": 1},
    "target_root": {"type": "string", "minLength": 1},
    "target_parent": {"type": "string", "minLength": 1},
    "target_locator_sha256": {"$ref": "#/$defs/sha256"},
    "source_revision_sha256": {"$ref": "#/$defs/sha256"},
    "source_layout_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["READY", "BLOCKED"]},
    "block_reasons": {"type": "array", "uniqueItems": true, "items": {"const": "TARGET_EXISTS_NO_OVERWRITE"}},
    "mode": {"const": "COPY_ON_WRITE"},
    "activation": {"const": "VALIDATE_BEFORE_ACTIVATION"},
    "collision_policy": {"const": "FAIL_NO_OVERWRITE"},
    "source_write_operations": {"const": 0},
    "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mapping": {
      "type": "object",
      "required": ["artifact_id", "source_relative_path", "destination_relative_path", "size_bytes", "content_sha256"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^urn:integra:artifact:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "source_relative_path": {"type": "string", "minLength": 1},
        "destination_relative_path": {"type": "string", "pattern": "^source/"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
