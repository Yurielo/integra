{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yurielo/integra/schemas/seminartext_topic_drafts_v1.schema.json",
  "title": "Integra SeminarText real Topic drafts artifact v1",
  "type": "object",
  "required": ["input_artifact_ids", "input_content_sha256", "result", "schema_version", "semantic_status", "stage", "stage_data"],
  "properties": {
    "input_artifact_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "input_content_sha256": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "result": {
      "type": "object",
      "required": ["topic_count", "model_digest"],
      "properties": {
        "topic_count": {"type": "integer", "minimum": 1},
        "model_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "schema_version": {"const": "1.0"},
    "semantic_status": {"const": "REVIEW_REQUIRED"},
    "stage": {"const": "topics"},
    "stage_data": {
      "type": "object",
      "required": ["topics_document"],
      "properties": {
        "topics_document": {
          "type": "object",
          "required": ["schema_version", "component", "component_entrypoint", "model", "topics", "windows"],
          "properties": {
            "schema_version": {"const": "1.0"},
            "component": {"const": "seminartext"},
            "component_entrypoint": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "topics": {"type": "array", "minItems": 1, "items": {"type": "object"}},
            "windows": {"type": "array", "minItems": 1, "items": {"type": "object"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
