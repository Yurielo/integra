{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yurielo/integra/schemas/integra_state_v1.schema.json",
  "title": "Integra governed state v1",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "baseline_date",
    "standalone_products_preserved",
    "component_baseline_manifest",
    "data_ownership_contract",
    "project_lease_schema",
    "worker_protocol_contract",
    "adapter_spike_evidence",
    "capability_benchmark_evidence",
    "agent_team_contract",
    "core_alpha_evidence",
    "core_alpha_real_evidence",
    "operations_and_diagnostics_evidence",
    "migration_evidence",
    "playlist_evidence",
    "document_pipeline_evidence",
    "projects_sources_evidence",
    "transcript_topic_studio_evidence",
    "multi_source_alignment_evidence",
    "knowledge_integration_evidence",
    "media_integration_evidence",
    "cross_navigation_evidence",
    "obsidian_export_evidence",
    "execution_policy",
    "delivery_target",
    "release_scope",
    "roadmap",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "product": { "const": "Integra" },
    "baseline_date": { "type": "string", "format": "date" },
    "standalone_products_preserved": { "const": true },
    "component_baseline_manifest": {
      "const": "state/component_baselines_v1.json"
    },
    "data_ownership_contract": {
      "const": "state/data_ownership_v1.json"
    },
    "project_lease_schema": {
      "const": "schemas/project_lease_v1.schema.json"
    },
    "worker_protocol_contract": {
      "const": "state/worker_protocol_v1.json"
    },
    "adapter_spike_evidence": {
      "const": "state/adapter_spike_v1.json"
    },
    "capability_benchmark_evidence": {
      "const": "state/capability_benchmark_v1.json"
    },
    "agent_team_contract": {
      "const": "state/agent_team_v1.json"
    },
    "core_alpha_evidence": {
      "const": "state/core_alpha_v1.json"
    },
    "core_alpha_real_evidence": {
      "const": "state/core_alpha_real_v1.json"
    },
    "operations_and_diagnostics_evidence": {
      "const": "state/operations_and_diagnostics_v1.json"
    },
    "migration_evidence": {
      "const": "state/migration_v1.json"
    },
    "playlist_evidence": {
      "const": "state/playlist_v1.json"
    },
    "document_pipeline_evidence": {
      "const": "state/document_pipeline_v1.json"
    },
    "projects_sources_evidence": {
      "const": "state/projects_sources_v1.json"
    },
    "transcript_topic_studio_evidence": {
      "const": "state/transcript_topic_studio_v1.json"
    },
    "multi_source_alignment_evidence": {
      "const": "state/multi_source_alignment_v1.json"
    },
    "knowledge_integration_evidence": {
      "const": "state/knowledge_integration_v1.json"
    },
    "media_integration_evidence": {
      "const": "state/media_integration_v1.json"
    },
    "cross_navigation_evidence": {
      "const": "state/cross_navigation_v1.json"
    },
    "obsidian_export_evidence": {
      "const": "state/obsidian_export_v1.json"
    },
    "execution_policy": {
      "type": "object",
      "required": [
        "safe_roadmap_implementation",
        "merge",
        "runtime_reconciliation",
        "release",
        "live_external_actions",
        "protected_data",
        "semantic_acceptance",
        "destructive_migration",
        "source_repository_changes"
      ],
      "properties": {
        "safe_roadmap_implementation": { "const": "STANDING_AUTHORITY_AFTER_DEPENDENCIES" },
        "merge": { "const": "AUTO_AFTER_FAIL_CLOSED_GATES" },
        "runtime_reconciliation": { "const": "AUTO_GOVERNED_AFTER_FAIL_CLOSED_GATES" },
        "release": { "const": "EXPLICIT_AUTHORITY_REQUIRED" },
        "live_external_actions": { "const": "EXPLICIT_AUTHORITY_REQUIRED" },
        "protected_data": { "const": "EXPLICIT_AUTHORITY_REQUIRED" },
        "semantic_acceptance": { "const": "EXPLICIT_HUMAN_DECISION_REQUIRED" },
        "destructive_migration": { "const": "EXPLICIT_AUTHORITY_REQUIRED" },
        "source_repository_changes": { "const": "EXPLICIT_SCOPE_REQUIRED" }
      },
      "additionalProperties": false
    },
    "delivery_target": {
      "type": "object",
      "required": ["id", "authorization_issue", "priority_order", "deferred_status", "acceptance_gate"],
      "properties": {
        "id": { "const": "READY_APP_V1" },
        "authorization_issue": { "const": 62 },
        "priority_order": {
          "const": ["R9C", "R10", "ONEDRIVE_PUBLICATION_V1", "R12", "R13", "R14"]
        },
        "deferred_status": { "const": "DEFERRED_TO_LATER_WORK" },
        "acceptance_gate": { "const": "R14" }
      },
      "additionalProperties": false
    },
    "release_scope": {
      "type": "object",
      "required": ["target", "required_modules", "deferred_modules", "deferred_social_platforms", "deferred", "gated_not_authorized"],
      "properties": {
        "target": { "const": "READY_APP_V1" },
        "required_modules": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "deferred_modules": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "deferred_social_platforms": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "deferred": {
          "type": "array",
          "minItems": 16,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "gated_not_authorized": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "roadmap": {
      "type": "array",
      "minItems": 35,
      "items": {
        "type": "object",
        "required": ["id", "issue", "status", "depends_on"],
        "properties": {
          "id": { "type": "string" },
          "issue": { "type": "integer", "minimum": 2 },
          "status": {
            "enum": ["ACCEPTED", "IN_REVIEW", "PARTIAL", "PLANNED", "DEFERRED_UNTIL_DEPENDENCY", "DEFERRED_TO_LATER_WORK", "HUMAN_GATE"]
          },
          "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
