{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Integra review runtime wheel cache v1",
  "type": "object",
  "required": ["schema_version", "artifact_type", "requirements", "python", "source", "wheels"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "integra.review_runtime_wheel_cache"},
    "requirements": {"type": "object", "required": ["path", "sha256"]},
    "python": {"type": "object", "required": ["version", "platform"]},
    "source": {"type": "object", "required": ["index", "retrieval_mode", "command"]},
    "wheels": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "version", "filename", "sha256"]}}
  },
  "additionalProperties": false
}
