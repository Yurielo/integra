{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integra.local/schemas/native_macos_app_evidence_v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "status", "issue", "dependencies", "implementation", "acceptance", "reference_mac", "safety", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"}, "status": {"const": "ACCEPTED"}, "issue": {"const": 28},
    "dependencies": {"const": ["ONEDRIVE_PUBLICATION_V1"]},
    "implementation": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/file"}},
    "acceptance": {"type": "object"}, "reference_mac": {"type": "object"}, "safety": {"type": "object"},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
