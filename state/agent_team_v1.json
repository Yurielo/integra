{
  "schema_version": "1.0",
  "status": "PRODUCT_OWNER_AUTHORIZED",
  "lead_agent": "product-owner",
  "human_product_owner_authority": "RETAINED_FOR_GENUINE_GATES",
  "activation_policy": "RISK_BASED_MINIMAL_SET",
  "execution_policy": "AUTONOMOUS_UNTIL_GENUINE_HUMAN_GATE",
  "default_systems": {
    "planning": "GITHUB_ISSUES_AND_MILESTONES",
    "documentation": "REPOSITORY_MARKDOWN",
    "jira": "EXPLICIT_EXTERNAL_SCOPE_REQUIRED",
    "confluence": "EXPLICIT_EXTERNAL_SCOPE_REQUIRED"
  },
  "roles": [
    {"id": "product-owner", "mode": "LEAD_READ_ONLY", "registration": ".codex/agents/product-owner.toml", "contract": ".codex/agents/product-owner.md"},
    {"id": "system-architect", "mode": "READ_ONLY_ADVISORY", "registration": ".codex/agents/system-architect.toml", "contract": ".codex/agents/system-architect.md"},
    {"id": "backend-developer", "mode": "IMPLEMENTATION", "registration": ".codex/agents/backend-developer.toml", "contract": ".codex/agents/backend-developer.md"},
    {"id": "frontend-developer", "mode": "IMPLEMENTATION", "registration": ".codex/agents/frontend-developer.toml", "contract": ".codex/agents/frontend-developer.md"},
    {"id": "database-architect", "mode": "DESIGN_AND_IMPLEMENTATION", "registration": ".codex/agents/database-architect.toml", "contract": ".codex/agents/database-architect.md"},
    {"id": "qa-test-engineer", "mode": "TEST_IMPLEMENTATION", "registration": ".codex/agents/qa-test-engineer.toml", "contract": ".codex/agents/qa-test-engineer.md"},
    {"id": "ci-cd-engineer", "mode": "IMPLEMENTATION", "registration": ".codex/agents/ci-cd-engineer.toml", "contract": ".codex/agents/ci-cd-engineer.md"},
    {"id": "github-pr-reviewer", "mode": "READ_ONLY", "registration": ".codex/agents/github-pr-reviewer.toml", "contract": ".codex/agents/github-pr-reviewer.md"},
    {"id": "jira-sprint-planner", "mode": "PLANNING", "registration": ".codex/agents/jira-sprint-planner.toml", "contract": ".codex/agents/jira-sprint-planner.md"},
    {"id": "confluence-doc-writer", "mode": "DOCUMENTATION", "registration": ".codex/agents/confluence-doc-writer.toml", "contract": ".codex/agents/confluence-doc-writer.md"}
  ],
  "handoff_required_fields": [
    "authority",
    "outcome",
    "acceptance_criteria",
    "scope",
    "forbidden_actions",
    "write_owner",
    "evidence",
    "tests",
    "risks",
    "next_boundary"
  ],
  "safeguards": {
    "all_roles_required_for_every_task": false,
    "routine_human_dispatch_required": false,
    "human_product_owner_may_be_impersonated": false,
    "source_repositories_read_only_by_default": true,
    "external_system_access_inferred_from_role_name": false,
    "qa_and_pr_review_independent": true
  }
}
